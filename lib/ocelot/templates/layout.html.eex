<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= @title %> · Ocelot</title>
    <style>
      :root {
        color-scheme: light dark;
        --bg: #f8fafc;
        --panel: #ffffff;
        --fg: #0f172a;
        --muted: #64748b;
        --border: #e2e8f0;
        --accent: #d97706;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b1120;
          --panel: #111827;
          --fg: #e2e8f0;
          --muted: #94a3b8;
          --border: #1f2937;
        }
      }

      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 14px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      a { color: inherit; }
      h1 { display: flex; align-items: center; gap: .75rem; margin: 0 0 1rem; font-size: 1.25rem; }
      h2 { margin: 1.5rem 0 .5rem; font-size: 1rem; }
      pre { margin: 0; padding: .75rem 1rem; overflow-x: auto; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; }
      .mono, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }
      .muted, .empty { color: var(--muted); }

      header { display: flex; align-items: baseline; gap: .75rem; padding: .75rem 1.5rem; background: var(--panel); border-bottom: 1px solid var(--border); }
      header .brand { color: var(--accent); font-size: 1.1rem; font-weight: 700; text-decoration: none; }
      main { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }

      .states { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
      .states a { padding: .25rem .75rem; border: 1px solid var(--border); border-radius: 999px; background: var(--panel); text-decoration: none; }
      .states a.active { border-color: var(--accent); color: var(--accent); }
      .states .count { margin-left: .25rem; color: var(--muted); font-variant-numeric: tabular-nums; }

      table { width: 100%; border-collapse: collapse; background: var(--panel); border: 1px solid var(--border); border-radius: 6px; }
      th, td { padding: .5rem .75rem; border-bottom: 1px solid var(--border); text-align: left; white-space: nowrap; }
      th { color: var(--muted); font-weight: 600; }
      td.args { max-width: 24rem; overflow: hidden; text-overflow: ellipsis; }

      .state { display: inline-block; padding: 0 .5rem; border-radius: 4px; font-size: 12px; font-weight: 600; color: #fff; background: #64748b; }
      .state-available { background: #2563eb; }
      .state-executing { background: #d97706; }
      .state-retryable { background: #ea580c; }
      .state-completed { background: #16a34a; }
      .state-discarded { background: #dc2626; }
      .state-suspended { background: #7c3aed; }

      .pagination { display: flex; justify-content: center; gap: 1rem; margin-top: 1rem; }
      .details { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1.5rem; margin: 0; }
      .details dt { color: var(--muted); }
      .details dd { margin: 0; }
      .error { margin-bottom: .75rem; }
      .error .muted { margin-bottom: .25rem; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="<%= jobs_path(@base, []) %>">Ocelot</a>
      <span class="muted mono"><%= inspect(@oban) %></span>
    </header>
    <main>
      <%= @inner_content %>
    </main>
  </body>
</html>
