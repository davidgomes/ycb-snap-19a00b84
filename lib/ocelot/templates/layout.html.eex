<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h(@title) %> · Ocelot</title>
    <style>
      :root {
        --bg: #f6f7f9;
        --surface: #ffffff;
        --border: #e3e6ea;
        --text: #1f2328;
        --muted: #667085;
        --accent: #b45309;
        --accent-soft: #fef3c7;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }

      a { color: inherit; }

      code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; }

      .topbar {
        display: flex;
        align-items: baseline;
        gap: 12px;
        padding: 14px 24px;
        background: #1f2328;
        color: #fff;
      }

      .brand { font-size: 18px; font-weight: 700; text-decoration: none; }
      .brand::before { content: "●"; color: #f59e0b; margin-right: 8px; }
      .tagline { color: #9aa4b2; }

      main { max-width: 1280px; margin: 0 auto; padding: 24px; }

      .layout { display: flex; gap: 24px; align-items: flex-start; }
      .sidebar { flex: 0 0 220px; }
      .content { flex: 1; min-width: 0; }

      .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; }

      .sidebar h2, .section-title {
        margin: 0 0 8px;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--muted);
      }

      .nav-list { display: flex; flex-direction: column; padding: 6px; }

      .nav-list a {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 6px;
        text-decoration: none;
        overflow-wrap: anywhere;
      }

      .nav-list a:hover, .tabs a:hover { background: var(--bg); }
      .nav-list a.active, .tabs a.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }

      .count { color: var(--muted); font-variant-numeric: tabular-nums; }
      .active .count { color: inherit; }

      .tabs { display: flex; flex-wrap: wrap; gap: 4px; padding: 6px; margin-bottom: 16px; }
      .tabs a { display: flex; gap: 6px; padding: 6px 10px; border-radius: 6px; text-decoration: none; text-transform: capitalize; }

      table { width: 100%; border-collapse: collapse; }
      th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); vertical-align: top; }
      th { font-size: 12px; font-weight: 600; color: var(--muted); white-space: nowrap; }
      tbody tr:last-child td { border-bottom: 0; }
      tbody tr:hover { background: #fafbfc; }
      td.args { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); }
      td.nowrap { white-space: nowrap; }
      .worker { font-weight: 600; text-decoration: none; }
      .worker:hover { text-decoration: underline; }
      .id { color: var(--muted); text-decoration: none; font-variant-numeric: tabular-nums; }

      .badge {
        display: inline-block;
        padding: 1px 8px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: #eef0f3;
        color: #475467;
      }

      .state-scheduled { background: #ede9fe; color: #6d28d9; }
      .state-available { background: #dbeafe; color: #1d4ed8; }
      .state-executing { background: #ffedd5; color: #c2410c; }
      .state-retryable { background: #fef9c3; color: #a16207; }
      .state-completed { background: #dcfce7; color: #15803d; }
      .state-discarded { background: #fee2e2; color: #b91c1c; }

      .pagination { display: flex; align-items: center; justify-content: flex-end; gap: 12px; margin-top: 16px; color: var(--muted); }
      .pagination a, .button {
        padding: 6px 12px;
        border: 1px solid var(--border);
        border-radius: 6px;
        background: var(--surface);
        color: var(--text);
        text-decoration: none;
      }

      .empty { padding: 48px 24px; text-align: center; color: var(--muted); }

      .back { display: inline-block; margin-bottom: 16px; color: var(--muted); text-decoration: none; }
      .back:hover { color: var(--text); }

      .detail-header { display: flex; align-items: center; gap: 12px; margin-bottom: 16px; }
      .detail-header h1 { margin: 0; font-size: 22px; overflow-wrap: anywhere; }

      .section { margin-bottom: 24px; }

      .facts { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin: 0; padding: 16px; }
      .facts dt { font-size: 12px; color: var(--muted); }
      .facts dd { margin: 2px 0 0; overflow-wrap: anywhere; }

      pre { margin: 0; padding: 16px; overflow-x: auto; white-space: pre-wrap; word-break: break-word; }

      .error + .error { border-top: 1px solid var(--border); }
      .error-meta { padding: 12px 16px 0; font-size: 12px; color: var(--muted); }

      @media (max-width: 800px) {
        .layout { flex-direction: column; align-items: stretch; }
        .sidebar { flex-basis: auto; }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="<%= h(jobs_path(@base)) %>">Ocelot</a>
      <span class="tagline">Oban dashboard</span>
    </header>
    <main>
<%= @inner_content %>
    </main>
  </body>
</html>
