<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= h(@title) %> · Ocelot</title>
    <style>
      :root { --fg: #1f2328; --muted: #656d76; --border: #d0d7de; --bg: #f6f8fa; --accent: #0969da; }
      * { box-sizing: border-box; }
      body { margin: 0; font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; color: var(--fg); }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      header { display: flex; align-items: center; gap: 1rem; padding: .75rem 1.5rem; border-bottom: 1px solid var(--border); background: var(--bg); }
      header .brand { font-weight: 600; font-size: 1.1rem; color: var(--fg); }
      main { padding: 1.5rem; max-width: 1200px; margin: 0 auto; }
      h1 { font-size: 1.25rem; margin: 0 0 1rem; }
      h2 { font-size: 1rem; margin: 1.5rem 0 .5rem; }
      .states { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
      .states a { display: flex; flex-direction: column; min-width: 110px; padding: .5rem .75rem; border: 1px solid var(--border); border-radius: 6px; color: var(--fg); }
      .states a:hover { text-decoration: none; border-color: var(--accent); }
      .states a.active { border-color: var(--accent); background: #ddf4ff; }
      .states .count { font-size: 1.25rem; font-weight: 600; }
      .states .label { color: var(--muted); text-transform: capitalize; }
      form.filters { display: flex; gap: .5rem; align-items: center; margin-bottom: 1rem; }
      select, button { font: inherit; padding: .25rem .5rem; border: 1px solid var(--border); border-radius: 6px; background: #fff; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: .5rem; border-bottom: 1px solid var(--border); vertical-align: top; }
      th { color: var(--muted); font-weight: 500; }
      td.args { font-family: ui-monospace, monospace; font-size: 12px; color: var(--muted); max-width: 400px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .badge { display: inline-block; padding: 0 .5rem; border-radius: 999px; font-size: 12px; background: var(--bg); border: 1px solid var(--border); }
      .badge.completed { background: #dafbe1; border-color: #4ac26b; }
      .badge.executing, .badge.available { background: #ddf4ff; border-color: #54aeff; }
      .badge.retryable, .badge.scheduled { background: #fff8c5; border-color: #d4a72c; }
      .badge.discarded, .badge.cancelled { background: #ffebe9; border-color: #ff8182; }
      .pagination { display: flex; justify-content: space-between; margin-top: 1rem; }
      .empty { color: var(--muted); padding: 2rem 0; text-align: center; }
      dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; margin: 0; }
      dt { color: var(--muted); }
      dd { margin: 0; }
      pre { background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: .75rem; overflow-x: auto; font-size: 12px; }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="<%= path(@base, "/") %>">Ocelot</a>
    </header>
    <main>
      <%= @inner %>
    </main>
  </body>
</html>
