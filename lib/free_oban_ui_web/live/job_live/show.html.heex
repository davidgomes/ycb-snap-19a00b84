<div class="space-y-6">
  <.link navigate={~p"/jobs"} class="text-sm font-medium text-zinc-600 hover:text-zinc-900">
    ← All jobs
  </.link>

  <div class="flex items-start justify-between gap-3">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-900"><%= @job.worker %></h1>
      <p class="mt-1 text-sm text-zinc-600">
        #<%= @job.id %> · <%= @job.queue %> · <%= @job.state %>
      </p>
    </div>
    <div class="flex gap-2">
      <button
        :if={@job.state in ~w(available scheduled retryable executing)}
        phx-click="cancel"
        class="rounded-md bg-zinc-100 px-3 py-1.5 text-sm font-semibold hover:bg-zinc-200"
      >
        Cancel
      </button>
      <button
        :if={@job.state in ~w(completed discarded cancelled retryable)}
        phx-click="retry"
        class="rounded-md bg-zinc-900 px-3 py-1.5 text-sm font-semibold text-white hover:bg-zinc-700"
      >
        Retry
      </button>
    </div>
  </div>

  <dl class="grid grid-cols-2 gap-3 text-sm">
    <div>
      <dt class="text-zinc-500">Attempt</dt>
      <dd><%= @job.attempt %>/<%= @job.max_attempts %></dd>
    </div>
    <div>
      <dt class="text-zinc-500">Priority</dt>
      <dd><%= @job.priority %></dd>
    </div>
    <div>
      <dt class="text-zinc-500">Scheduled</dt>
      <dd><%= @job.scheduled_at %></dd>
    </div>
    <div>
      <dt class="text-zinc-500">Inserted</dt>
      <dd><%= @job.inserted_at %></dd>
    </div>
  </dl>

  <section>
    <h2 class="text-sm font-semibold text-zinc-700">Args</h2>
    <pre class="mt-2 overflow-x-auto rounded-lg bg-zinc-100 p-3 text-xs"><%= Jason.encode!(@job.args, pretty: true) %></pre>
  </section>

  <section :if={@job.errors != []}>
    <h2 class="text-sm font-semibold text-zinc-700">Errors</h2>
    <pre class="mt-2 overflow-x-auto rounded-lg bg-rose-50 p-3 text-xs"><%= Jason.encode!(@job.errors, pretty: true) %></pre>
  </section>
</div>
