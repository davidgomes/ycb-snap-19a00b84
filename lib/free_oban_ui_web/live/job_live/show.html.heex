<.header>
  Job <%= @job.id %>
  <:subtitle><%= @job.worker %></:subtitle>
  <:actions>
    <div class="flex gap-2">
      <.button :if={Jobs.can_retry?(@job)} id="retry-job" phx-click="retry">Retry</.button>
      <.button
        :if={Jobs.can_cancel?(@job)}
        id="cancel-job"
        phx-click="cancel"
        data-confirm="Cancel this job?"
      >
        Cancel
      </.button>
      <.button
        :if={Jobs.can_delete?(@job)}
        id="delete-job"
        phx-click="delete"
        data-confirm="Delete this job? This cannot be undone."
        class="bg-rose-600 hover:bg-rose-500"
      >
        Delete
      </.button>
    </div>
  </:actions>
</.header>

<.list>
  <:item title="State"><.state_badge state={@job.state} /></:item>
  <:item title="Queue"><%= @job.queue %></:item>
  <:item title="Worker"><%= @job.worker %></:item>
  <:item title="Attempt"><%= @job.attempt %> of <%= @job.max_attempts %></:item>
  <:item title="Priority"><%= @job.priority %></:item>
  <:item title="Tags"><%= if @job.tags == [], do: "—", else: Enum.join(@job.tags, ", ") %></:item>
  <:item title="Attempted by">
    <%= if @job.attempted_by in [nil, []], do: "—", else: Enum.join(@job.attempted_by, ", ") %>
  </:item>
  <:item title="Inserted at"><%= format_datetime(@job.inserted_at) %></:item>
  <:item title="Scheduled at"><%= format_datetime(@job.scheduled_at) %></:item>
  <:item title="Attempted at"><%= format_datetime(@job.attempted_at) %></:item>
  <:item title="Completed at"><%= format_datetime(@job.completed_at) %></:item>
  <:item title="Cancelled at"><%= format_datetime(@job.cancelled_at) %></:item>
  <:item title="Discarded at"><%= format_datetime(@job.discarded_at) %></:item>
</.list>

<section class="mt-12">
  <h2 class="text-sm font-semibold leading-6 text-zinc-800">Args</h2>
  <pre
    id="job-args"
    class="mt-2 overflow-x-auto rounded-lg bg-zinc-50 p-4 text-xs leading-5 text-zinc-800"
  ><%= format_json(@job.args, pretty: true) %></pre>
</section>

<section class="mt-8">
  <h2 class="text-sm font-semibold leading-6 text-zinc-800">Meta</h2>
  <pre
    id="job-meta"
    class="mt-2 overflow-x-auto rounded-lg bg-zinc-50 p-4 text-xs leading-5 text-zinc-800"
  ><%= format_json(@job.meta, pretty: true) %></pre>
</section>

<section id="job-errors" class="mt-8">
  <h2 class="text-sm font-semibold leading-6 text-zinc-800">Errors</h2>
  <p :if={@job.errors == []} class="mt-2 text-sm leading-6 text-zinc-500">No errors.</p>
  <div :for={error <- Enum.reverse(@job.errors)} class="mt-4">
    <p class="text-sm leading-6 text-zinc-600">
      Attempt <%= error["attempt"] %> at <%= format_datetime(error["at"]) %>
    </p>
    <pre class="mt-2 overflow-x-auto rounded-lg bg-rose-50 p-4 text-xs leading-5 text-rose-900"><%= error["error"] %></pre>
  </div>
</section>

<.back navigate={~p"/jobs?state=#{@job.state}"}>Back to jobs</.back>
