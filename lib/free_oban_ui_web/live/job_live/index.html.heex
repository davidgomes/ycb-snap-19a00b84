<.header>
  Oban Jobs
</.header>

<form phx-change="filter" class="mt-4 flex flex-wrap items-end gap-4">
  <div>
    <label class="block text-sm font-medium text-zinc-700">State</label>
    <select name="state" class="mt-1 rounded-lg border-zinc-300 text-sm">
      <option :for={state <- @states} value={state} selected={state == @state}>
        <%= String.capitalize(state) %>
      </option>
    </select>
  </div>

  <div>
    <label class="block text-sm font-medium text-zinc-700">Queue</label>
    <select name="queue" class="mt-1 rounded-lg border-zinc-300 text-sm">
      <option value="" selected={is_nil(@queue)}>All queues</option>
      <option :for={queue <- @queues} value={queue} selected={queue == @queue}>
        <%= queue %>
      </option>
    </select>
  </div>
</form>

<table class="mt-6 w-full text-left text-sm">
  <thead>
    <tr class="border-b border-zinc-200 text-zinc-500">
      <th class="py-2 pr-4">ID</th>
      <th class="py-2 pr-4">Worker</th>
      <th class="py-2 pr-4">Queue</th>
      <th class="py-2 pr-4">State</th>
      <th class="py-2 pr-4">Attempt</th>
      <th class="py-2 pr-4">Inserted at</th>
      <th class="py-2 pr-4">Actions</th>
    </tr>
  </thead>
  <tbody id="jobs">
    <tr :for={job <- @jobs} id={"job-#{job.id}"} class="border-b border-zinc-100">
      <td class="py-2 pr-4"><%= job.id %></td>
      <td class="py-2 pr-4"><%= job.worker %></td>
      <td class="py-2 pr-4"><%= job.queue %></td>
      <td class="py-2 pr-4">
        <span class={"rounded-full px-2 py-1 text-xs font-medium #{state_badge_class(job.state)}"}>
          <%= job.state %>
        </span>
      </td>
      <td class="py-2 pr-4"><%= job.attempt %>/<%= job.max_attempts %></td>
      <td class="py-2 pr-4"><%= job.inserted_at %></td>
      <td class="py-2 pr-4">
        <div class="flex gap-2">
          <button
            :if={job.state in ["scheduled", "retryable", "discarded", "cancelled"]}
            type="button"
            phx-click="retry"
            phx-value-id={job.id}
            class="text-brand hover:underline"
          >
            Retry
          </button>
          <button
            :if={job.state in ["available", "scheduled", "executing", "retryable"]}
            type="button"
            phx-click="cancel"
            phx-value-id={job.id}
            class="text-brand hover:underline"
          >
            Cancel
          </button>
          <button
            type="button"
            phx-click="delete"
            phx-value-id={job.id}
            data-confirm="Delete this job?"
            class="text-red-600 hover:underline"
          >
            Delete
          </button>
        </div>
      </td>
    </tr>
  </tbody>
</table>

<p :if={@jobs == []} class="mt-4 text-zinc-500">No jobs found.</p>

<div class="mt-6 flex items-center justify-between">
  <.link
    :if={@page > 1}
    patch={~p"/oban/jobs?#{%{state: @state, queue: @queue, page: @page - 1}}"}
    class="text-brand hover:underline"
  >
    &larr; Previous
  </.link>
  <span :if={@page <= 1}></span>

  <.link
    :if={@has_more?}
    patch={~p"/oban/jobs?#{%{state: @state, queue: @queue, page: @page + 1}}"}
    class="text-brand hover:underline"
  >
    Next &rarr;
  </.link>
</div>
