<div class="space-y-6">
  <div>
    <h1 class="text-2xl font-semibold text-zinc-900">Oban jobs</h1>
    <p class="mt-1 text-sm text-zinc-600">Latest 50 jobs. Filter by state or queue.</p>
  </div>

  <form id="job-filters" phx-change="filter" class="flex flex-wrap gap-3">
    <label class="flex flex-col text-sm text-zinc-700">
      State
      <select name="state" class="mt-1 rounded-lg border border-zinc-300 px-2 py-1">
        <option value="" selected={@filters["state"] == ""}>All</option>
        <%= for state <- FreeObanUi.Jobs.states() do %>
          <option value={state} selected={@filters["state"] == state}>
            <%= state %>
          </option>
        <% end %>
      </select>
    </label>
    <label class="flex flex-col text-sm text-zinc-700">
      Queue
      <input
        type="text"
        name="queue"
        value={@filters["queue"]}
        placeholder="default"
        class="mt-1 rounded-lg border border-zinc-300 px-2 py-1"
      />
    </label>
  </form>

  <div :if={@jobs == []} id="jobs-empty" class="rounded-lg border border-dashed border-zinc-300 p-6 text-sm text-zinc-500">
    No jobs match these filters.
  </div>

  <ul id="jobs" class="divide-y divide-zinc-200 rounded-lg border border-zinc-200">
    <%= for job <- @jobs do %>
      <li id={"job-#{job.id}"} class="space-y-2 p-4">
        <div class="flex items-start justify-between gap-3">
          <div>
            <.link navigate={~p"/jobs/#{job.id}"} class="font-medium text-zinc-900 hover:underline">
              <%= job.worker %>
            </.link>
            <p class="text-sm text-zinc-600">
              #<%= job.id %> · <%= job.queue %> · <%= job.state %> · attempt <%= job.attempt %>/<%= job.max_attempts %>
            </p>
          </div>
          <div class="flex shrink-0 gap-2">
            <button
              :if={job.state in ~w(available scheduled retryable executing)}
              phx-click="cancel"
              phx-value-id={job.id}
              class="rounded-md bg-zinc-100 px-2 py-1 text-xs font-semibold hover:bg-zinc-200"
            >
              Cancel
            </button>
            <button
              :if={job.state in ~w(completed discarded cancelled retryable)}
              phx-click="retry"
              phx-value-id={job.id}
              class="rounded-md bg-zinc-900 px-2 py-1 text-xs font-semibold text-white hover:bg-zinc-700"
            >
              Retry
            </button>
          </div>
        </div>
      </li>
    <% end %>
  </ul>
</div>
