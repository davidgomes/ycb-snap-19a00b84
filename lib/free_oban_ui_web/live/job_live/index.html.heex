<div class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-900">Oban jobs</h1>
      <p class="mt-1 text-sm text-zinc-600">Recent jobs, newest first. Limited to 100 rows.</p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <.link
      patch={~p"/jobs"}
      class={[
        "rounded-full px-3 py-1 text-sm font-medium",
        if(is_nil(@state) or @state == "",
          do: "bg-zinc-900 text-white",
          else: "bg-zinc-100 text-zinc-700 hover:bg-zinc-200"
        )
      ]}
    >
      All
    </.link>
    <.link
      :for={state <- FreeObanUi.Jobs.states()}
      patch={~p"/jobs?#{[state: state]}"}
      class={[
        "rounded-full px-3 py-1 text-sm font-medium",
        if(@state == state,
          do: "bg-zinc-900 text-white",
          else: "bg-zinc-100 text-zinc-700 hover:bg-zinc-200"
        )
      ]}
    >
      {state}
    </.link>
  </div>

  <div class="overflow-hidden rounded-xl border border-zinc-200">
    <table class="min-w-full divide-y divide-zinc-200 text-sm">
      <thead class="bg-zinc-50 text-left text-xs font-semibold uppercase tracking-wide text-zinc-500">
        <tr>
          <th class="px-4 py-3">ID</th>
          <th class="px-4 py-3">Worker</th>
          <th class="px-4 py-3">Queue</th>
          <th class="px-4 py-3">State</th>
          <th class="px-4 py-3">Attempt</th>
          <th class="px-4 py-3">Scheduled</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-zinc-100 bg-white">
        <tr :if={@jobs == []}>
          <td colspan="7" class="px-4 py-8 text-center text-zinc-500">No jobs match this filter.</td>
        </tr>
        <tr :for={job <- @jobs} id={"job-#{job.id}"}>
          <td class="px-4 py-3 font-mono text-xs">{job.id}</td>
          <td class="px-4 py-3">{job.worker}</td>
          <td class="px-4 py-3">{job.queue}</td>
          <td class="px-4 py-3">
            <span class={["rounded-full px-2 py-0.5 text-xs font-medium", state_class(job.state)]}>
              {job.state}
            </span>
          </td>
          <td class="px-4 py-3">{job.attempt}/{job.max_attempts}</td>
          <td class="px-4 py-3 text-zinc-600">{Calendar.strftime(job.scheduled_at, "%Y-%m-%d %H:%M:%S")}</td>
          <td class="px-4 py-3 text-right">
            <div class="flex justify-end gap-3">
              <.link navigate={~p"/jobs/#{job.id}"} class="font-medium text-brand hover:underline">
                View
              </.link>
              <button
                :if={job.state in ["completed", "discarded", "cancelled", "retryable"]}
                phx-click="retry"
                phx-value-id={job.id}
                class="font-medium text-zinc-700 hover:text-zinc-900"
              >
                Retry
              </button>
              <button
                :if={job.state in ["available", "scheduled", "retryable", "executing"]}
                phx-click="cancel"
                phx-value-id={job.id}
                data-confirm="Cancel this job?"
                class="font-medium text-rose-700 hover:text-rose-900"
              >
                Cancel
              </button>
            </div>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
