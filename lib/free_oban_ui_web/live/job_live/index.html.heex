<.header>
  Jobs
  <:subtitle>The most recent Oban jobs, refreshed automatically.</:subtitle>
</.header>

<nav id="job-states" class="mt-8 flex flex-wrap gap-2">
  <.state_tab id="state-all" patch={~p"/jobs"} active={is_nil(@state)} count={@total}>
    all
  </.state_tab>
  <.state_tab
    :for={state <- Jobs.states()}
    id={"state-#{state}"}
    patch={~p"/jobs?#{[state: state]}"}
    active={@state == state}
    count={@counts[state]}
  >
    <%= state %>
  </.state_tab>
</nav>

<.table
  id="jobs"
  rows={@jobs}
  row_id={&"job-#{&1.id}"}
  row_click={&JS.navigate(~p"/jobs/#{&1.id}")}
>
  <:col :let={job} label="ID"><%= job.id %></:col>
  <:col :let={job} label="Worker"><%= job.worker %></:col>
  <:col :let={job} label="Queue"><%= job.queue %></:col>
  <:col :let={job} label="State"><.state_badge state={job.state} /></:col>
  <:col :let={job} label="Attempt"><%= job.attempt %>/<%= job.max_attempts %></:col>
</.table>

<p :if={@jobs == []} id="jobs-empty" class="mt-8 text-center text-sm text-zinc-500">
  No jobs found.
</p>
