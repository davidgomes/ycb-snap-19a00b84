<.header>
  Jobs
  <:subtitle>
    Showing <%= length(@jobs) %> of <%= total(@counts, @filters.state) %> jobs, newest first.
  </:subtitle>
  <:actions>
    <form id="queue-filter" phx-change="filter">
      <.input
        type="select"
        id="queue-filter-select"
        name="queue"
        label="Queue"
        value={@filters.queue}
        options={@queues}
        prompt="All queues"
      />
    </form>
  </:actions>
</.header>

<nav id="state-filters" class="mt-8 flex flex-wrap gap-2">
  <.link
    id="state-filter-all"
    patch={jobs_path(%{@filters | state: nil})}
    class={state_tab_class(is_nil(@filters.state))}
  >
    All <span class="ml-1 font-normal opacity-70"><%= total(@counts, nil) %></span>
  </.link>
  <.link
    :for={state <- @states}
    id={"state-filter-#{state}"}
    patch={jobs_path(%{@filters | state: state})}
    class={state_tab_class(@filters.state == state)}
  >
    <%= String.capitalize(state) %>
    <span class="ml-1 font-normal opacity-70"><%= @counts[state] %></span>
  </.link>
</nav>

<.table
  id="jobs"
  rows={@jobs}
  row_id={&"job-#{&1.id}"}
  row_click={fn job -> JS.navigate(~p"/jobs/#{job.id}") end}
>
  <:col :let={job} label="ID"><%= job.id %></:col>
  <:col :let={job} label="Worker">
    <span class="block font-semibold text-zinc-900"><%= job.worker %></span>
    <span class="block max-w-md truncate font-mono text-xs text-zinc-500">
      <%= Jason.encode!(job.args) %>
    </span>
  </:col>
  <:col :let={job} label="Queue"><%= job.queue %></:col>
  <:col :let={job} label="State"><.state_badge state={job.state} /></:col>
  <:col :let={job} label="Attempt"><%= job.attempt %>/<%= job.max_attempts %></:col>
  <:col :let={job} label="Time"><.relative_time at={state_timestamp(job)} /></:col>
  <:action :let={job}>
    <.link :if={Jobs.retryable?(job)} phx-click="retry" phx-value-id={job.id}>Retry</.link>
  </:action>
  <:action :let={job}>
    <.link
      :if={Jobs.cancellable?(job)}
      phx-click="cancel"
      phx-value-id={job.id}
      data-confirm="Are you sure you want to cancel this job?"
    >
      Cancel
    </.link>
  </:action>
</.table>

<p :if={@jobs == []} id="jobs-empty" class="py-10 text-center text-sm text-zinc-500">
  No jobs found.
</p>
